# Probr environment template — copy to `.env` and fill in values.
# `.env` is gitignored. Never commit real keys.

# Upstream Alloy API base URL (no trailing slash)
VITE_ALLOY_BASE_URL=https://api.connormerk.dev

# Optional — only required for the bulk-fetch / probe scripts under scripts/.
# The runtime app does NOT need this (public API).
VITE_ALLOY_API_KEY=
